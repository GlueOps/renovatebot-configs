{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":pinDevDependencies"
  ],
  "separateMinorPatch": true,
  "separateMultipleMajor": true,
  "separateMultipleMinor": true,
  "labels": [
    "auto-update"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "30 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "strict",
   "gitIgnoredAuthors": ["github@glueops.dev", "vendors@glueops.dev", "github-actions[bot]@users.noreply.github.com", "186083205+public-glueops-renovatebot[bot]@users.noreply.github.com"],
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboardAutoclose": true,
  "dependencyDashboard": true,
  "recreateWhen": "always",
  "semanticCommits": "enabled",
  "lockFileMaintenance": { "enabled": true },
  "forkProcessing": "enabled",
  "packageRules": [
    {
      "description": "Immediate updates for GlueOps-owned packages",
      "matchPackageNames": [
        "glueops/**",
        "ghcr.io/glueops/**",
        "ghcr.repo.gpkg.io/glueops/**"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Immediate updates for Helm charts from gpkg.io",
      "matchDatasources": ["helm"],
      "matchRegistryUrls": ["https://**.gpkg.io/**"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Immediate digest updates: digests are aged against the tag's newest release, so frequently re-pushed tags never clear minimumReleaseAge",
      "matchUpdateTypes": ["digest", "pinDigest"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Conventional PR titles for release-please (squash commit = PR title): all other updates are deps:, a patch release under Dependencies. Empty scope avoids deps(deps):",
      "matchUpdateTypes": ["patch", "pin", "pinDigest", "digest", "lockFileMaintenance", "rollback", "bump", "replacement"],
      "semanticCommitType": "deps",
      "semanticCommitScope": ""
    },
    {
      "description": "Minor and major dependency updates are feat(deps), a minor release. No '!': a dependency major is not a breaking change to this repo",
      "matchUpdateTypes": ["minor", "major"],
      "semanticCommitType": "feat"
    }
  ]
}
